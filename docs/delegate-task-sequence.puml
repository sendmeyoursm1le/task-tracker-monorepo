@startuml
title Task Tracker - Delegate Task Sequence Diagram

actor Client
participant "Task Service" as TS
participant "User Service" as US
database "Task Database" as TD
database "User Database" as UD

Client -> TS: POST /tasks/{taskId}/delegate?assigneeId=X
activate TS

alt Invalid assigneeId
    TS --> Client: HTTP 400 Bad Request
else Valid request
    TS -> TD: Find task by ID
    activate TD
    TD --> TS: Task data / Not found
    deactivate TD

    alt Task not found
        TS --> Client: HTTP 404 Not Found
    else Task exists
        TS -> US: GET /users/{assigneeId}
        activate US

        US -> UD: Find user by ID
        activate UD
        UD --> US: User data / Not found
        deactivate UD

        alt User found
            US --> TS: HTTP 200 OK
            deactivate US

            TS -> TD: Update assigneeId
            activate TD
            TD --> TS: Updated task
            deactivate TD

            TS --> Client: HTTP 200 OK
        else User not found
            US --> TS: HTTP 404 Not Found
            deactivate US
            TS --> Client: HTTP 404 Not Found
        else User Service unavailable
            US --> TS: Timeout / 5xx
            deactivate US
            TS --> Client: HTTP 503 Service Unavailable
        end
    end
end

note over TS,US
  Task Service checks users only through HTTP.
  It does not access User Database directly.
end note

deactivate TS
@enduml
