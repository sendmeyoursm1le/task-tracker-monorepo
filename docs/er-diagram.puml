@startuml
left to right direction
title Task Tracker - ER Diagram

package "User Service Database" {
  entity "User" as user {
    * id : BIGINT <<PK>>
    --
    first_name : VARCHAR(100)
    last_name : VARCHAR(100)
    email : VARCHAR(255) <<UNIQUE>>
  }
}

package "Task Service Database" {
  entity "Task" as task {
    * id : BIGINT <<PK>>
    --
    title : VARCHAR(255)
    status : ENUM
    creator_id : BIGINT
    assignee_id : BIGINT
  }
}

note right of task::status
  Values: TODO, IN_PROGRESS, DONE
end note

note bottom of task
  creator_id and assignee_id are user IDs,
  not foreign keys to User.
end note

@enduml
